# Kopiraj u .env (cp .env.example .env). .env se NE commita.

# Baza (koriste je docker-compose.yml i docker-compose.prod.yml)
DB_NAME=artconnect
DB_USER=artconnect
# Na EC2 obavezno promijeni u jaku lozinku
DB_PASSWORD=artconnect

# Samo produkcija (docker-compose.prod.yml)
# :80 = HTTP na IP adresi; za domenu upiši artconnect-fer.duckdns.org (Caddy sam uzima HTTPS)
SITE_ADDRESS=:80

# E-mail prvog administratora; prazno = ne stvara se nitko
# ARTCONNECT_ADMIN_EMAIL=

# Google OAuth (zasad se ne koristi; backend ih čita tek kad se doda OAuth konfiguracija)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Pregled zapisa na /logs (Dozzle iza Caddyja), samo produkcija.
# Hash: docker run --rm caddy:2 caddy hash-password --plaintext '<lozinka>'
# Hash obavezno u jednostrukim navodnicima (sadrži $).
LOGS_USER=tim
LOGS_PASSWORD_HASH='$2a$14$zamijeni.ovo.hashom'

# Geokodiranje je lokalno prema lažnom endpointu; produkcija koristi Nominatim.
# Produkcijske vrijednosti su opcionalne; zadane vrijednosti definirane su u application-prod.yml.
# ARTCONNECT_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# ARTCONNECT_GEOCODING_USER_AGENT=ArtConnect/1.0 (+https://artconnect-fer.duckdns.org)
# ARTCONNECT_GEOCODING_MIN_INTERVAL=1s
# ARTCONNECT_GEOCODING_MAX_WAIT=2s
