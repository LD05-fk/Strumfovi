@startuml
' ER dijagram tablica 1. ciklusa (Liquibase changesetovi 001-009 i 021).
' Prikazani su ključevi i najvažniji stupci; svi stupci su u changelogovima.
hide circle
hide methods
skinparam linetype polyline

entity "users" as users {
  * id : uuid <<PK>>
  --
  email
  display_name
  role : ARTIST | ORGANIZER | ADMIN
  status : INVITED | ONBOARDING | ACTIVE | BLOCKED | DELETED
  organizer_approval : PENDING | APPROVED
}

entity "organizer_profiles" as organizer_profiles {
  * user_id : uuid <<PK, FK>>
  --
  organization_name
}

entity "artist_profiles" as artist_profiles {
  * user_id : uuid <<PK, FK>>
  --
  biography
  artist_statement
}

entity "artist_links" as artist_links {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  label
  url
}

entity "past_exhibitions" as past_exhibitions {
  * id : uuid <<PK>>
  --
  * artist_id : uuid <<FK>>
  title
  year
  place
}

entity "artist_profile_art_fields" as artist_profile_art_fields {
  * user_id : uuid <<PK, FK>>
  * art_field_id : uuid <<PK, FK>>
}

entity "artworks" as artworks {
  * id : uuid <<PK>>
  --
  * artist_id : uuid <<FK>>
  title
  year
  visibility : PUBLIC | PRIVATE
  hidden_by_admin
}

entity "artwork_images" as artwork_images {
  * id : uuid <<PK>>
  --
  * artwork_id : uuid <<FK>>
  * file_id : uuid <<FK>>
  alt_text
  position
}

entity "stored_files" as stored_files {
  * id : uuid <<PK>>
  --
  * owner_id : uuid <<FK>>
  content_type
  size_bytes
  storage_key
}

entity "opportunities" as opportunities {
  * id : uuid <<PK>>
  --
  * organizer_id : uuid <<FK>>
  * type_id : uuid <<FK>>
  title
  deadline
  location_type : PHYSICAL | ONLINE
  city, latitude, longitude
  status : PREPARATION ... FINISHED
  archived
  hidden_by_admin
}

entity "opportunity_art_fields" as opportunity_art_fields {
  * opportunity_id : uuid <<PK, FK>>
  * art_field_id : uuid <<PK, FK>>
}

entity "art_fields" as art_fields {
  * id : uuid <<PK>>
  --
  code
  name
  active
}

entity "opportunity_types" as opportunity_types {
  * id : uuid <<PK>>
  --
  code
  name
  active
}

entity "system_settings" as system_settings {
  * key <<PK>>
  --
  value
  updated_by : uuid <<FK>>
}

entity "spring_session" as spring_session {
  * primary_id <<PK>>
  --
  principal_name = users.id
  expiry_time
}

entity "spring_session_attributes" as spring_session_attributes {
  * session_primary_id <<PK, FK>>
  * attribute_name <<PK>>
}

users ||--o| organizer_profiles
users ||--o| artist_profiles
artist_profiles ||--o{ artist_links
artist_profiles ||--o{ past_exhibitions
artist_profiles ||--o{ artist_profile_art_fields
art_fields ||--o{ artist_profile_art_fields
users ||--o{ artworks
artworks ||--o{ artwork_images
stored_files ||--o| artwork_images
users ||--o{ stored_files
users ||--o{ opportunities
opportunity_types ||--o{ opportunities
opportunities ||--o{ opportunity_art_fields
art_fields ||--o{ opportunity_art_fields
users |o--o{ system_settings
spring_session ||--o{ spring_session_attributes
@enduml
